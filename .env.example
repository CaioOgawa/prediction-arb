# Polymarket — CLOB API
POLY_PRIVATE_KEY=0x_sua_private_key_aqui
POLY_API_KEY=seu_api_key
POLY_API_SECRET=seu_api_secret
POLY_API_PASSPHRASE=sua_passphrase

# Proxy wallet (gerada pelo Polymarket ao conectar via UI)
POLY_PROXY_WALLET=0x_endereco_proxy_wallet

# Dados externos
NEWSAPI_KEY=sua_newsapi_key
COINGECKO_API_KEY=sua_coingecko_key

# The Odds API — odds de bookmakers para mercados esportivos
# Plano free: 500 req/mês — obtenha em https://the-odds-api.com
# Usado por: 01_pipeline/odds_collector.py e 04_signals/signal_generator.py (modo odds)
ODDS_API_KEY=sua_odds_api_key

# Database
DATABASE_URL=sqlite:///./data/db/polymarket.db

# Modo de operação: "paper" ou "live"
# SEMPRE comece com "paper" e só mude para "live" após validação completa
TRADING_MODE=paper

# Capital inicial para paper trading (USDC)
PAPER_CAPITAL=1000.0
