# Polymarket — CLOB API
POLY_PRIVATE_KEY=0x_sua_private_key_aqui
POLY_API_KEY=seu_api_key
POLY_API_SECRET=seu_api_secret
POLY_API_PASSPHRASE=sua_passphrase

# The Odds API — odds de bookmakers para mercados esportivos
# Plano free: 500 req/mês — obtenha em https://the-odds-api.com
# Usado por: pipeline/odds_collector.py e signals/signal_generator.py (modo odds)
ODDS_API_KEY=sua_odds_api_key

# Modo de operação: "paper" ou "live"
# SEMPRE comece com "paper" e só mude para "live" após validação completa
TRADING_MODE=paper

# Alertas Telegram (notify.py) — sem isso, degradação silenciosa (universo
# zerado, pipeline parado, exits no floor) não gera NENHUMA notificação.
# 1. Crie um bot com @BotFather no Telegram, copie o token dele em TELEGRAM_BOT_TOKEN
# 2. Descubra seu chat_id com @userinfobot (ou getUpdates da API) e cole em TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=123456:seu_bot_token_aqui
TELEGRAM_CHAT_ID=-100seu_chat_id_aqui
