<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.caio.polymarket-cycle-light</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/caio/.local/bin/uv</string>
        <string>run</string>
        <string>python</string>
        <string>/Users/caio/faculdade/projects/polymarket/run_cycle.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/caio/faculdade/projects/polymarket</string>

    <!-- A cada 30 minutos (1800 segundos) -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/caio/faculdade/projects/polymarket/logs/cycle_light.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/caio/faculdade/projects/polymarket/logs/cycle_light_error.log</string>

    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/caio</string>
        <key>PATH</key>
        <string>/Users/caio/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
